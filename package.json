{
  "name": "distributed-wagering-processor",
  "private": true,
  "packageManager": "bun@1.3.3",
  "scripts": {
    "start": "bun dist/main.js",
    "build": "bun -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --project test/tsconfig.json",
    "frontend:install": "bun install --cwd frontend --frozen-lockfile",
    "frontend": "bun run --cwd frontend start",
    "frontend:typecheck": "bun run --cwd frontend typecheck",
    "frontend:build": "bun run --cwd frontend build",
    "migration:up": "bun dist/infrastructure/persistence/database.js up",
    "migration:down": "bun dist/infrastructure/persistence/database.js down",
    "test:unit": "bun test test/unit.test.ts",
    "test:integration": "bun test test/integration.test.ts",
    "test:concurrency": "bun test test/concurrency.test.ts",
    "test:load": "bun test/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.922.0",
    "@mikro-orm/core": "6.5.9",
    "@mikro-orm/migrations": "6.5.9",
    "@mikro-orm/postgresql": "6.5.9",
    "@nestjs/common": "11.1.8",
    "@nestjs/core": "11.1.8",
    "@nestjs/platform-express": "11.1.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "typescript": "5.9.3"
  }
}
