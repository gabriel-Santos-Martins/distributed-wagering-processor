{
  "realm": "wagering",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "provider", "description": "Game provider: submits wagering transactions for its own provider id" },
      { "name": "operator", "description": "Back office: manages wallets, reads ledgers and transactions, runs reconciliation" }
    ]
  },
  "clients": [
    {
      "clientId": "provider-a",
      "name": "Provider A (local development)",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-a-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "wagering-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        },
        {
          "name": "provider id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-a", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provider B (local development)",
      "enabled": true,
      "publicClient": false,
      "secret": "provider-b-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "wagering-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        },
        {
          "name": "provider id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "provider-b", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "back-office",
      "name": "Back office operator (local development)",
      "enabled": true,
      "publicClient": false,
      "secret": "back-office-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "wagering-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "wagering-console",
      "name": "Local test console: operator and provider console-local",
      "enabled": true,
      "publicClient": false,
      "secret": "wagering-console-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "wagering-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "wagering-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        },
        {
          "name": "provider id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": { "claim.name": "provider_id", "claim.value": "console-local", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    { "username": "service-account-provider-a", "enabled": true, "serviceAccountClientId": "provider-a", "realmRoles": ["provider"] },
    { "username": "service-account-provider-b", "enabled": true, "serviceAccountClientId": "provider-b", "realmRoles": ["provider"] },
    { "username": "service-account-back-office", "enabled": true, "serviceAccountClientId": "back-office", "realmRoles": ["operator"] },
    { "username": "service-account-wagering-console", "enabled": true, "serviceAccountClientId": "wagering-console", "realmRoles": ["operator", "provider"] }
  ]
}
